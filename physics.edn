;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README: ISCO 4323 (Transport Clerks) is a Wave 0 (cognitive substrate)
;; occupation with no robotics gate -- the actor keeps consignment and
;; dispatch records. The physical work behind those records is the
;; consignment check-in at the dispatch counter: a parcel is lifted onto the
;; weighing scale so its declared weight can be checked against the waybill,
;; and the checked parcels are carried on a cart to the loading bay.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-4323"
 :cases
 [{:id :parcel-to-check-scale
   :kind :manipulator
   :procedure "arm lifts a consignment parcel from the counter onto the check-weighing scale"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 5.5 :m2-kg 4.0
            :from [0.65 0.20] :to [0.40 -0.15] :duration-s 2.0 :steps 500}
   :sweep {:param :payload-kg :values [1.0 5.0 10.0 20.0 30.0]}
   :quantity :peak-tau1-nm
   :limit {:max 160.0 :basis "estimate: continuous shoulder torque of a ~20 kg-payload collaborative arm"}
   :boundary {:lo 0.5 :hi 60.0}}
  {:id :checked-parcels-to-loading-bay
   :kind :transport
   :procedure "cart robot carries the checked parcels from the dispatch counter to the loading bay"
   :params {:mass-kg 80.0 :distance-m 35.0 :v-max-mps 1.2 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 180.0 :crr 0.02
            :cog-height-m 0.60 :support-half-length-m 0.35}
   :sweep {:param :payload-kg :values [20.0 60.0 120.0 200.0 300.0]}
   :quantity :cycle-time-s
   :limit {:max 40.0 :basis "estimate: one counter-to-bay leg short enough that parcels checked before cut-off still make the vehicle"}
   :boundary {:lo 5.0 :hi 1500.0}}]}
